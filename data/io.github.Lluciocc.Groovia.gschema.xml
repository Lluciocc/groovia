<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="groovia">
	<schema id="io.github.Lluciocc.Groovia" path="/io/github/Lluciocc/Groovia/">
		<key name="crossfade-index" type="i"><default>3</default><summary>Crossfade duration</summary><description>0 means disabled, followed by 1, 3, 5, 8 and 10 seconds.</description></key>
		<key name="auto-dj-enabled" type="b"><default>false</default><summary>Enable Auto DJ</summary></key>
		<key name="auto-dj-style" type="s"><default>'balanced'</default><summary>Auto DJ transition style</summary></key>
		<key name="auto-dj-length" type="s"><default>'automatic'</default><summary>Auto DJ transition length</summary></key>
		<key name="auto-dj-beat-matching" type="b"><default>true</default><summary>Use beat matching when analysis is confident</summary></key>
		<key name="auto-dj-phrase-matching" type="b"><default>true</default><summary>Prefer phrase-safe transitions</summary></key>
		<key name="auto-dj-tempo-matching" type="b"><default>true</default><summary>Allow conservative tempo matching</summary></key>
		<key name="auto-dj-smart-eq" type="b"><default>true</default><summary>Use bass-aware Auto DJ mixing</summary></key>
		<key name="auto-dj-silence-detection" type="b"><default>true</default><summary>Use silence analysis for transition planning</summary></key>
		<key name="auto-dj-artwork-animation" type="b"><default>true</default><summary>Animate artwork during Auto DJ transitions</summary></key>
		<key name="auto-dj-show-badge" type="b"><default>true</default><summary>Show the Auto DJ badge</summary></key>
		<key name="gapless" type="b"><default>true</default><summary>Gapless playback</summary></key>
		<key name="replaygain" type="b"><default>false</default><summary>ReplayGain normalization</summary></key>
		<key name="dynamic-background" type="b"><default>true</default><summary>Dynamic background</summary></key>
		<key name="vinyl-rotation" type="b"><default>true</default><summary>Vinyl rotation</summary></key>
		<key name="animations" type="b"><default>true</default><summary>Interface animations</summary></key>
		<key name="now-playing-notifications" type="b"><default>true</default><summary>Now playing notifications</summary></key>
		<key name="background-playback" type="b"><default>false</default><summary>Keep Groovia running after its window is closed</summary></key>
		<key name="spotdl-legal-acknowledged" type="b"><default>false</default><summary>spotDL legal notice acknowledged</summary></key>
		<key name="download-format" type="s"><default>'mp3'</default><summary>Download format</summary></key>
		<key name="download-bitrate" type="s"><default>'auto'</default><summary>Download bitrate</summary></key>
		<key name="sync-mode" type="s"><default>'safe'</default><summary>Playlist synchronization mode</summary></key>
		<key name="auto-sync-policy" type="s"><default>'manual'</default><summary>Automatic synchronization policy</summary></key>
		<key name="playlist-cover-policy" type="s"><default>'follow'</default><summary>Playlist cover policy</summary></key>
		<key name="playlist-order-policy" type="s"><default>'spotify'</default><summary>Playlist order policy</summary></key>
		<key name="lyrics-fallback" type="b"><default>true</default><summary>Use LRCLIB when Better Lyrics is unavailable</summary></key>
		<key name="lyrics-auto-missing" type="b"><default>false</default><summary>Search missing lyrics automatically</summary></key>
		<key name="lyrics-preserve-edited" type="b"><default>true</default><summary>Preserve edited lyrics</summary></key>
		<key name="lyrics-show-availability" type="b"><default>true</default><summary>Show lyrics availability</summary></key>
		<key name="lyrics-wave" type="b"><default>true</default><summary>Lyrics wave effect</summary></key>
		<key name="lyrics-glow" type="b"><default>true</default><summary>Lyrics glow effect</summary></key>
		<key name="lyrics-artwork-preference" type="s"><default>'animated'</default><summary>Lyrics background artwork preference</summary></key>
	</schema>
</schemalist>
