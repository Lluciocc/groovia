  <releases>
		<release version="1.3.0" date="2026-08-24">
		  <description>
		    <ul>
		      <li>Added dedicated album and artist pages.</li>
		      <li>Added artist artwork, biographies, and locally cached metadata.</li>
		      <li>Added optional background playback.</li>
		      <li>Improved downloads, Auto DJ dependencies, and library grouping.</li>
		      <li>Improved Windows startup, packaging, icons, and installer metadata.</li>
		    </ul>
		  </description>
		</release>
		
		<release version="1.2.0" date="2026-08-19">
		  <description>
		    <p>Improved Groovia's interface, playback experience, Auto DJ integration, and cross-platform support.</p>
		  </description>
		</release>
    <release version="1.1.1" date="2026-08-09">
      <description>
        <p>Initial release of Groovia, with local library scanning, album browsing, playlists, queue-based playback, animated vinyl artwork, lyrics support, Spotify imports through spotDL, and the optional Auto DJ transition engine.</p>
      </description>
    </release>
  </releases>
