{
  "target": {
    "architecture": "arm64",
    "minimum_macos": "13.0",
    "python": "3.13"
  },
  "python": {
    "pyinstaller": "6.22.2",
    "pygobject": "3.54.5",
    "numpy": "2.4.6",
    "scipy": "1.18.0",
    "pytest": "8.4.2",
    "ruff": "0.16.2",
    "isort": "6.0.1"
  },
  "homebrew_formulae": [
    "python@3.13",
    "pkgconf",
    "meson",
    "ninja",
    "gettext",
    "glib",
    "gobject-introspection",
    "gtk4",
    "libadwaita",
    "adwaita-icon-theme",
    "hicolor-icon-theme",
    "gstreamer",
    "gst-plugins-base",
    "gst-plugins-good",
    "gst-plugins-bad",
    "gst-plugins-ugly",
    "gst-libav",
    "librsvg"
  ],
  "minimum_native_versions": {
    "glib-2.0": "2.80",
    "gtk4": "4.14",
    "libadwaita-1": "1.5",
    "gstreamer-1.0": "1.24"
  },
  "optional_bundled_tools": {
    "policy": "disabled-by-default",
    "spotdl": null,
    "ffmpeg": null,
    "ffprobe": null,
    "deno": null
  }
}
